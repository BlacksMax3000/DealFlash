# ============================================================
# Radar de Ofertas — variables de entorno
# Copia este archivo como `.env` y rellena los valores.
# En GitHub Actions NO se usa este archivo: se usan Secrets.
# NUNCA subas el .env real a GitHub.
# ============================================================

# API de Z.ai (para el análisis con GLM) — https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=tu_api_key_aqui

# Bot de Telegram (token que te da @BotFather)
TELEGRAM_BOT_TOKEN=123456789:AAAA-tu_token_aqui

# Canal de destino: @usuario_publico o ID numérico -100xxxxxxxxxx
TELEGRAM_CHAT_ID=@mi_canal_de_ofertas

# Tag de Amazon Afiliados (asociados.amazon.com) — termina en -20 para amazon.com
AMAZON_TAG=turadar-20

# ============================================================
# CAPTACIÓN AUTOMÁTICA (prospección multi-superficie, v2)
# Todos son OPCIONALES: el sistema funciona sin ellos.
# ============================================================

# Canales/grupos ADICIONALES de Telegram donde el bot sea admin
# (separados por coma: @canal2,-1001234567890)
TELEGRAM_CHAT_IDS=

# URL pública de tu canal principal (para el CTA "únete al canal" del sitio web)
TELEGRAM_CHANNEL_URL=https://t.me/mi_canal_de_ofertas

# URL pública del sitio de captación. EN GITHUB ACTIONS SE DEDUCE SOLO
# (https://TU-USUARIO.github.io/nombre-del-repo/). Solo úsalo si usas otro host.
SITE_BASE_URL=

# Bluesky: cuenta gratis + contraseña de app
# (bsky.app → Ajustes → Contraseñas de app) y activa captacion.bluesky en config.yaml
BLUESKY_HANDLE=tucuenta.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Discord: una o varias URLs de webhook separadas por coma
# (canal → Editar canal → Integraciones → Webhooks → Nuevo webhook → Copiar URL)
DISCORD_WEBHOOK_URLS=

# Reddit (OPCIONAL, desactivado por defecto en config.yaml — LEE SUS REGLAS PRIMERO)
# Crea una app "script" en https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
